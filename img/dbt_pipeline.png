<!-- Customer JS ======================================================= -->
<script>
  /* Custom JS Added Via Theme Settings */
  document.addEventListener('DOMContentLoaded', function() {
  // Find the container holding the link ('Forgot Password?' or 'Log In')
  var linkDiv = document.querySelector('.auth__content .auth__link');
  // Find the main page heading element
  var pageTitleElement = document.querySelector('.auth__content h1.auth__title');
  
  // Proceed only if we found the link container and the title element
  if (linkDiv && pageTitleElement) {
    
    var pageTitleText = pageTitleElement.textContent.trim(); // Get the text content of the H1
    var message = ''; // Initialize an empty message variable
    
    // --- Define Message based on Page Title ---
    
    if (pageTitleText === 'Recover Password') {
      // MESSAGE FOR THE RECOVER PASSWORD PAGE (with spam note)
      message = '<p><strong>Reset email may land in spam!</strong> After submitting, please check your spam or junk folders if you don\'t see the email in your inbox.</p>';
      
    } else if (pageTitleText === 'Login' || pageTitleText === 'Course Login') { 
      // MESSAGE FOR THE LOGIN PAGE (your supporter clarification)
      message = '<p><strong>Trying to Log In?</strong> This is for supporters with access to a purchased course (your login is created automatically). Want to support my content? <a href="https://lukebarousse.com/courses" target="_blank" rel="noopener noreferrer">View available courses here</a>.</p>';
    }
    // You could add more 'else if' blocks here for other pages if needed
    
    // --- Create and Insert the Box ONLY if a message was defined ---
    if (message) {
      var clarificationBox = document.createElement('div');
      clarificationBox.className = 'login-clarification-box'; // Use the same class for consistent styling
      clarificationBox.innerHTML = message; // Set the determined message
      
      // Insert the box after the link div (same placement as before)
      linkDiv.insertAdjacentElement('afterend', clarificationBox);
    }
    
  } else {
    // Log an error if key elements weren't found (for troubleshooting)
    console.log('Kajabi Clarification Script: Could not find required elements (.auth__content .auth__link or h1.auth__title).');
  }
});
</script>
  </body>
</html>